# Read-only upstream for a process-owned local fork. Never broadcast to this URL.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Optional historical block; requires an upstream provider retaining its full state.
# NORIA_FORK_BLOCK=504585228
# Optional public addresses to impersonate locally. Never provide a private key.
# NORIA_OWNER=0x00000000000000000000000000000000000a11ce
# NORIA_TAKER=0x0000000000000000000000000000000000000b0b
NORIA_FUNDING_ASSET=ETH
NORIA_COLLATERAL_UNITS=10000000000000000000
NORIA_SAFETY_HF_WAD=1400000000000000000
NORIA_COMFORTABLE_HF_WAD=2000000000000000000
# ETH has 18 decimals; USDC has 6. The USDC path supplies collateral then borrows USDC.
# NORIA_FUNDING_ASSET=USDC
# NORIA_COLLATERAL_UNITS=20000000000
# Repeated related-party fills test allocation, never organic volume or external yield.
NORIA_FILL_ROUNDS=2
