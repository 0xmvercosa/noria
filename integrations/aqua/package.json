{
  "name": "@noria/aqua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arbitrum WETH/USDC Aqua execution boundary and verifiable local-fork rehearsals for Noria",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "example:plan": "tsx src/cli.ts plan examples/discovery-response.json",
    "contracts:test": "forge test --root contracts",
    "fork:rehearse": "tsx scripts/rehearse.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "0.3.4",
    "@1inch/swap-vm-sdk": "0.4.4",
    "viem": "2.38.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "ws@>=8 <9": "8.21.3"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./boundary": "./src/boundary.ts",
    "./financing": "./src/financing.ts",
    "./official": "./src/official.ts",
    "./verifier": "./src/verifier.ts",
    "./rehearsal-plan": "./src/rehearsal-plan.ts"
  }
}
