# Optional: leave blank to use The Graph's public Subgraph MCP endpoint.
GRAPH_API_KEY=

# Optional RPC overrides. Defaults are configured in src/config/networks.ts.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
UNICHAIN_RPC_URL=

# Public Privy application identifier. Configure allowed origins in Privy.
# This value is bundled into the client at build time; it is not a secret key.
NEXT_PUBLIC_PRIVY_APP_ID=

# Local development only. Keep disabled on public hosts and Vercel.
# Requires Foundry binaries (forge/anvil) on PATH and a loopback-bound server.
NORIA_ENABLE_LOCAL_FORK=0
