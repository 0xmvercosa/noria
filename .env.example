# Optional: leave blank to use The Graph's public Subgraph MCP endpoint.
GRAPH_API_KEY=

# Optional RPC overrides. Defaults are configured in src/config/networks.ts.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
UNICHAIN_RPC_URL=

# Public Privy application identifier. Enable email/wallet login, Ethereum
# embedded wallets and exact allowed origins. /reserve can submit user-confirmed
# transfers and Aave supply/withdrawal on Arbitrum through Privy. EUR onramp
# availability depends on the Privy dashboard and provider region.
# This value is bundled into the client at build time; it is not a secret key.
NEXT_PUBLIC_PRIVY_APP_ID=

# Public Arbitrum factory address after deployment. The server verifies its
# exact reviewed runtime and canonical protocol configuration before preparing
# any Aqua wallet action. Missing configuration returns deployment-required.
# See docs/1inch/live-launch.md. No server key or background signer is used.
NORIA_AQUA_FACTORY_ADDRESS=

# Local development only. Keep disabled on public hosts and Vercel.
# Requires Foundry binaries (forge/anvil) on PATH and a loopback-bound server.
NORIA_ENABLE_LOCAL_FORK=0

# Optional comma-separated browser origins permitted to call /api/mcp.
# Native MCP clients do not send Origin and require no entry here.
# The request's own origin is always permitted. No wildcard is supported.
NORIA_MCP_ALLOWED_ORIGINS=
